DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Playwright e2e (copy into .env.e2e — never commit secrets)
E2E_BASE_URL=http://localhost:3000
E2E_EMAIL=
E2E_PASSWORD=

# GitHub Actions — repo Secrets / Variables (see .github/workflows/)
# Secrets: NEON_API_KEY (or DATABASE_URL_TEST), E2E_EMAIL, E2E_PASSWORD
# Secrets (CD environment "production"): DATABASE_URL
# Variables: NEON_PROJECT_ID, optional NEON_TEST_PARENT_BRANCH (default main)
