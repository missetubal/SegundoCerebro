# App
# Public URL of the app (local: http://localhost:3000; Vercel: https://....vercel.app)
AUTH_URL=http://localhost:3000

# Auth.js — generate with: `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres connection string (or local Docker Postgres)
# Example Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
